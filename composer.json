{
  "name": "tangible/doctrine",
  "description": "The Tangible Doctrine helper.",
  "type": "library",
  "license": "GPL-2.0-only",
  "autoload": {
    "psr-4": {
      "Tangible\\Doctrine\\": "./src"
    }
  },
  "authors": [
    {
      "name": "Team Tangible"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.2",
    "doctrine/migrations": "~3.9",
    "doctrine/orm": "~3.5.3",
    "doctrine/dbal": "~3.8",
    "symfony/cache": "~6.4.31",
    "symfony/serializer": "^7.3.4",
    "symfony/property-access": "^7.3.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "yoast/phpunit-polyfills": "^1.0",
    "symfony/phpunit-bridge": "^7.3",
    "symfony/dotenv": "^7"
  }
}
